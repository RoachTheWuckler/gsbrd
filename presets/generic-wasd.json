        {"label": "A", "key": "a", "pos": [0, 1], "size": [1, 1]},
        {"label": "S", "key": "s", "pos": [1, 1], "size": [1, 1]},
        {"label": "D", "key": "d", "pos": [2, 1], "size": [1, 1]},
        {"label": "", "key": "space", "pos": [0, 2], "size": [3, 1]}
