{
    "font": {
        "name": "Iosevka",
        "local": false,
        "size": 24
    },
    "colors": {
        "bg": [0, 255, 0],
        "key_up": [200, 200, 220],
        "key_down": [120, 120, 140],
        "key_up_text": [0, 0, 0],
        "key_down_text": [255, 255, 255]
    },
    "key_style": {
        "outline_size": 4,
        "fill": true,
        "border_radius": 8
    },
    "positioning": {
        "grid_x": 48,
        "grid_y": 48,
        "grid_spacing_x": 4,
        "grid_spacing_y": 4
    },
    "keys": [
        {"label": "W", "key": "w", "pos": [2, 1], "size": [1, 1]},
        {"label": "A", "key": "a", "pos": [1, 2], "size": [1, 1]},
        {"label": "S", "key": "s", "pos": [2, 2], "size": [1, 1]},
        {"label": "D", "key": "d", "pos": [3, 2], "size": [1, 1]},

        {"label": "Q", "key": "q", "pos": [1, 1], "size": [1, 1]},
        {"label": "E", "key": "e", "pos": [3, 1], "size": [1, 1]},

        {"label": "R", "key": "r", "pos": [4, 1], "size": [1, 1]},

        {"label": "1", "key": "1", "pos": [1, 0], "size": [1, 1]},
        {"label": "2", "key": "2", "pos": [2, 0], "size": [1, 1]},
        {"label": "3", "key": "3", "pos": [3, 0], "size": [1, 1]},

        {"label": "[_]", "key": "space", "pos": [1, 3], "size": [3, 1]},
        {"label": "CTRL", "key": "lctrl", "pos": [0, 3], "size": [1, 1]},
        {"label": "⇧", "key": "lshift", "pos": [0, 2], "size": [1, 1]},
        {"label": "TAB", "key": "tab", "pos": [0, 1], "size": [1, 1]},

        {"label": "<", "key": "lmb", "pos": [6, 1.5], "size": [1, 1]},
        {"label": ">", "key": "rmb", "pos": [7, 1.5], "size": [1, 1]}
    ]
}